{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for Keel's main window. No filesystem or HTTP access is granted to the web view; file and network I/O happen in audited Rust commands. Only this window may call database, file and integration commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "opener:allow-open-url",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "allow-db-execute",
    "allow-db-query",
    "allow-db-execute-script",
    "allow-db-reset",
    "allow-db-info",
    "allow-backup-create",
    "allow-backup-list",
    "allow-backup-restore",
    "allow-backup-export",
    "allow-backup-import",
    "allow-data-wipe",
    "allow-file-save-text",
    "allow-file-open-text",
    "allow-file-open-binary",
    "allow-app-environment",
    "allow-integration-store-secret",
    "allow-integration-has-secret",
    "allow-integration-delete-secret",
    "allow-integration-delete-secrets",
    "allow-integration-fetch",
    "allow-ics-fetch-account",
    "allow-oauth-connect",
    "allow-oauth-revoke",
    "allow-focusbar-show",
    "allow-focusbar-hide",
    "allow-focusbar-is-visible",
    "allow-focusbar-was-visible",
    "allow-focusbar-reset-position",
    "allow-focusbar-focus-main"
  ]
}
